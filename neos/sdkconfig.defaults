# --- PSRAM -------------------------------------------------------------
# Tab5 has 32 MB hex PSRAM. Two things depend on this:
#   1. The ELF loader executes apps from PSRAM. Without SPIRAM it falls back
#      to a data-bus address that is not instruction-fetchable and the app
#      dies with an Instruction access fault.
#   2. The MIPI-DSI panel scans its framebuffer out of PSRAM. At the default
#      20 MHz the DSI cannot fetch fast enough -> "underrun happens" spam and
#      visible flicker at the right edge of the panel.
# SPIRAM_SPEED_200M depends on IDF_EXPERIMENTAL_FEATURES; without it the
# choice silently falls back to 20 MHz.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# --- flash -------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- partitions --------------------------------------------------------
# See partitions.csv. The single-app default caps the image at 1 MB, which the
# Wi-Fi host stack alone does not fit inside.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- ELF loader --------------------------------------------------------
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y

# --- FAT ---------------------------------------------------------------
# Long filenames. Without this "manifest.json" is invisible - a 4-char
# extension breaks 8.3 and it reads back as MANIFE~1.JSO.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Scanning + parsing + loading needs more than the 3.5 KB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192


# --- console -----------------------------------------------------------
# The console is also the upload link, and 115200 makes pushing an app to the
# card take longer than rebuilding it. Every USB-UART bridge in reach does
# 921600. idf.py monitor reads this, so it follows automatically.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# --- Wi-Fi, through the ESP32-C6 ---------------------------------------
# The P4 has no radio. esp_wifi_remote puts the ordinary esp_wifi API over
# SDIO to the C6, and esp_hosted is the transport underneath it.
#
# The board option is not cosmetic: it sets the six SDIO pins and the slave
# reset line, and it is the one place where those numbers are written down for
# this tablet. They match what was read off this unit (docs/specs_fingerprint.md):
# CLK 12, CMD 13, D0 11, D1 10, D2 9, D3 8, reset 15.
#
# Slot 1 is the C6; slot 0 is the microSD card and must stay free.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y

# Reset polarity, against the component's own default for this board.
#
# esp_hosted defaults the Tab5 to RESET_ACTIVE_LOW, which leaves GPIO 15 low at
# rest and pulses it high. GPIO 15 goes to the C6's EN pin, and EN low is what
# holds an ESP32 in reset - so the default leaves the slave held down and CMD5
# times out with sdmmc_init_ocr: send_op_cond (1) returned 0x107. Active high
# idles the line high and pulses it low, which is what an EN pin wants.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

# --- where the Wi-Fi host stack puts its memory -------------------------
# ESP-Hosted brings the whole SDIO transport up from a C constructor, before
# FreeRTOS is running. On the stock settings it takes ~132 KB of internal RAM
# doing it, and core init has already taken most of the rest, which leaves the
# scheduler unable to allocate the idle task's TCB - and that is an assert, not
# an error:
#
#   assert failed: xTaskCreateStaticPinnedToCore ... xPortCheckValidTCBMem
#
# with no app having run and nothing in the log to point at. The three settings
# below move that memory to PSRAM, of which this board has 32 MB.
#
# ALWAYSINTERNAL is the big one: it is the size below which malloc() prefers
# internal RAM, and at the 16 KB default essentially every buffer the host
# stack allocates qualifies. Anything that genuinely needs internal or DMA
# memory asks for it by capability and is unaffected.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y

# The transport's own DMA buffers, which are the largest single item and the
# one the settings above cannot move: they are allocated with MALLOC_CAP_DMA
# and would otherwise have to be internal. The P4's GDMA reaches PSRAM through
# the cache, which is what makes this option exist and what makes it safe here.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# ESP-Hosted asks for a 1 kHz tick and warns at boot without it. At 100 Hz the
# SDIO transport waits up to 10 ms on timeouts that were written expecting 1,
# which it reports as bus-level jitter.
CONFIG_FREERTOS_HZ=1000

# SNTP writes the RTC on every sync, so the tablet comes back from a power cut
# with a good clock rather than only a running one. Smooth mode is deliberately
# off: this clock is allowed to jump, and a step that takes an hour to apply is
# worse than one that is over immediately.
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
