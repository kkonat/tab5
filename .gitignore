# --- ESP-IDF build output ----------------------------------------------
build/
sdkconfig.old
sdkconfig.ci
dependencies.lock.bak

# Components pulled by the IDF component manager. Reproduced from
# idf_component.yml + dependencies.lock, both of which are tracked.
managed_components/

# --- tooling caches ----------------------------------------------------
.cache/
compile_commands.json
.clangd/
__pycache__/
*.py[cod]

# --- editors / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# --- machine-local configuration ---------------------------------------
# Paths and device names that differ per machine: the IDF checkout, the
# serial port, the card reader's drive letter. .env.local.example is the
# tracked template and README.md describes the keys.
.env.local

# --- serial / flash scratch -------------------------------------------
*.tmp

# Screenshots pulled off the tablet by scripts/screencap.py. Kept out of the
# repo on purpose: they are 1280x720 PNGs taken by the dozen while working on
# a screen, and the ones worth keeping belong in docs/ by hand.
screencaps/

# --- logs --------------------------------------------------------------
*.log

# --- generated ---------------------------------------------------------
# The build number is written into the build tree; build_number.txt is tracked.
neos_build.h

# --- work in progress --------------------------------------------------
# Apps that are not ready to publish live in a separate private repo,
# cloned here as lab/. Here rather than anywhere else because an app's
# CMakeLists reaches ../../neos/components: lab/<app>/ is the same depth as
# apps/<app>/, so an app builds from either and publishing one is a move.
# build-all, upload and deploy-card look in both directories.
/lab/

# --- other people's ----------------------------------------------------
# Emulator assets built by tools/genlcd from a MAME romset: a mask ROM and
# somebody's traced artwork, neither of which is ours to check in. The tool
# and its README are; the output is a card file, made locally.
*.lcd
*.gw
